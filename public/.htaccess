Options -Indexes
RewriteEngine On

# Forcer HTTPS (activer en production avec certificat SSL)
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Ne pas réécrire les fichiers et répertoires existants
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Tout le reste vers le front controller
RewriteRule ^ index.php [L]

# Protection des fichiers sensibles
<FilesMatch "\.(env|log|lock|job|sql|md|git|gitignore|example|ini|sh)$">
    Require all denied
</FilesMatch>

# Bloquer l'accès aux dossiers système
<IfModule mod_rewrite.c>
    RewriteRule (^|/)\.(?!well-known/) - [F]
</IfModule>

# Upload limit (override PHP default)
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
