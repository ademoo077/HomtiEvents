APP_NAME="Wilaya Harmonia"
APP_ENV=local
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=true
APP_URL=http://localhost:8080

# Base de données
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wilaya_harmonia
DB_USERNAME=root
DB_PASSWORD=

# Redis / File (queue, sessions, cache)
QUEUE_DRIVER=file
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# I18n
APP_LOCALE=fr
APP_LOCALES=fr,ar

# PWA
PWA_ENABLED=true

# Assistant IA (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@wilaya-harmonia.dz

# Uploads
UPLOAD_MAX_SIZE=5242880

# Sécurité
SESSION_SECURE=false
CSP_ENABLED=true

# Email (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=حومتي ايفانت
MAIL_ENCRYPTION=tls
CRON_TOKEN=
