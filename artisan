#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * CLI artisan de Wilaya Harmonia.
 *
 * Commandes :
 *   php artisan app:info          Affiche les informations du projet
 *   php artisan migrate           Exécute les scripts SQL
 *   php artisan seed              Insère les données de démonstration
 *   php artisan migrate:all       Schéma + données de référence + seed + landing
 *   php artisan queue:work        Traite les jobs de la file
 *   php artisan queue:watch       Traitement continu de la file
 *   php artisan sla:run           Exécute les alertes SLA dues
 *   php artisan backup            Sauvegarde la base de données
 *   php artisan key:generate      Génère une clé APP_KEY
 *   php artisan gallery:thumbs    Génère les vignettes 400px manquantes des photos
 */

define('BASE_PATH', __DIR__);

require BASE_PATH . '/vendor/autoload.php';
require BASE_PATH . '/app/Bootstrap.php';

use App\Bootstrap;
use App\Helpers\EvenementService;
use App\Helpers\Queue;
use App\Helpers\SlaHelper;

Bootstrap::boot();

$command = $argv[1] ?? 'help';

function runSqlFile(string $file): void
{
    if (! is_file($file)) {
        echo "Fichier introuvable : {$file}\n";
        return;
    }

    $sql = file_get_contents($file);
    $pdo = \App\Helpers\Database::connection();

    // Exécution requête par requête (gestion des DELIMITER implicites)
    $pdo->exec('SET FOREIGN_KEY_CHECKS = 0');
    foreach (splitSql($sql) as $query) {
        if (trim($query) !== '') {
            $pdo->exec($query);
        }
    }
    $pdo->exec('SET FOREIGN_KEY_CHECKS = 1');

    echo "OK : " . basename($file) . "\n";
}

function splitSql(string $sql): array
{
    // Sépare en instructions simples sans gestion de procédures stockées.
    $sql = preg_replace('/^--.*$/m', '', $sql);
    $parts = array_filter(explode(';', $sql));
    $result = [];
    foreach ($parts as $part) {
        $part = trim($part);
        if ($part !== '') {
            $result[] = $part;
        }
    }

    return $result;
}

/**
 * Traite les jobs de la file prêts à être exécutés.
 *
 * @return int nombre de jobs traités avec succès
 */
function processQueueJobs(): int
{
    $done = 0;
    foreach (Queue::pull(10) as $item) {
        $file = $item['file'];
        $job  = $item['job'];

        try {
            $instance = new $job['job']();
            $instance->handle($job['payload'] ?? []);
            Queue::delete($file);
            $done++;
        } catch (Throwable $e) {
            $attempts = ((int) ($job['attempts'] ?? 0)) + 1;

            if ($attempts >= 3) {
                Queue::delete($file);
                $instance = new $job['job']();
                $instance->failed($job['payload'] ?? [], $e);
                echo "Job {$job['job']} abandonné après {$attempts} tentative(s) : " . $e->getMessage() . "\n";
            } else {
                $job['attempts'] = $attempts;
                $job['delay']    = min(300, 10 * 2 ** ($attempts - 1));
                Queue::delete($file);
                file_put_contents(
                    $file,
                    json_encode($job, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES)
                );
                echo "Job {$job['job']} échoué (tentative {$attempts}) : " . $e->getMessage() . "\n";
            }
        }
    }

    return $done;
}

/**
 * Sauvegarde la base de données (dump SQL + schéma) dans storage/backups.
 * Passe par mysqldump si disponible, sinon dump PDO (CREATE + INSERT).
 */
function runBackup(): void
{
    $dir = BASE_PATH . '/storage/backups';
    if (! is_dir($dir)) {
        mkdir($dir, 0775, true);
    }

    $stamp = date('Ymd-His');
    $file  = $dir . '/backup-' . $stamp . '.sql';
    $pdo   = \App\Helpers\Database::connection();
    $db    = $pdo->query('SELECT DATABASE()')->fetchColumn();

    // Tentative mysqldump (plus fiable) sinon dump PHP.
    $mysqldump = trim((string) shell_exec('command -v mysqldump 2>/dev/null'));
    if ($mysqldump !== '') {
        $config = config('database');
        $cmd = escapeshellarg($mysqldump) . ' --single-transaction --routines --triggers'
            . ' -h ' . escapeshellarg((string) $config['host'])
            . ' -P ' . (int) $config['port']
            . ' -u ' . escapeshellarg((string) $config['username'])
            . ' ' . ($config['password'] !== '' ? '-p' . escapeshellarg((string) $config['password']) : '')
            . ' ' . escapeshellarg((string) $db) . ' > ' . escapeshellarg($file);
        shell_exec($cmd);
    }

    if (! is_file($file) || filesize($file) < 100) {
        $sql = "-- Wilaya Harmonia — Sauvegarde " . date('Y-m-d H:i:s') . "\n"
             . '-- Base : ' . $db . "\n\nSET FOREIGN_KEY_CHECKS = 0;\n\n";

        $tables = $pdo->query('SHOW TABLES')->fetchAll(PDO::FETCH_COLUMN);
        foreach ($tables as $table) {
            $create = $pdo->query('SHOW CREATE TABLE `' . $table . '`')->fetch(PDO::FETCH_NUM);
            $sql .= 'DROP TABLE IF EXISTS `' . $table . "`;\n";
            $sql .= $create[1] . ";\n\n";

            foreach ($pdo->query('SELECT * FROM `' . $table . '`') as $row) {
                $columns = array_keys($row);
                $values  = array_map(
                    static fn ($v) => $v === null ? 'NULL' : $pdo->quote((string) $v),
                    array_values($row)
                );
                $sql .= 'INSERT INTO `' . $table . '` (`' . implode('`, `', $columns) . '`) VALUES ('
                    . implode(', ', $values) . ");\n";
            }
            $sql .= "\n";
        }

        $sql .= "SET FOREIGN_KEY_CHECKS = 1;\n";
        file_put_contents($file, $sql);
    }

    // Compression gzip si disponible.
    $gzip = $dir . '/backup-' . $stamp . '.sql.gz';
    $gz   = gzopen($gzip, 'wb');
    if ($gz !== false) {
        gzwrite($gz, (string) file_get_contents($file));
        gzclose($gz);
        unlink($file);
        $file = $gzip;
    }

    echo "Backup créé : {$file} (" . round(filesize($file) / 1024, 1) . " Ko)\n";
}

switch ($command) {
    case 'help':
    case '--help':
        echo file_get_contents(__FILE__) ? '' : '';
        break;

    case 'app:info':
        echo 'Wilaya Harmonia ' . "\n";
        echo 'PHP      : ' . PHP_VERSION . "\n";
        echo 'Environn.: ' . config('app.env') . "\n";
        echo 'URL      : ' . config('app.url') . "\n";
        echo 'Base     : ' . config('database.database') . "\n";
        echo 'Queue    : ' . Queue::size() . " job(s) en attente\n";
        break;

    case 'key:generate':
        $key = 'base64:' . base64_encode(random_bytes(32));
        echo "Clé générée : {$key}\n";
        $envFile = BASE_PATH . '/.env';
        if (is_file($envFile)) {
            file_put_contents(
                $envFile,
                preg_replace('/^APP_KEY=.*$/m', 'APP_KEY=' . $key, file_get_contents($envFile))
            );
            echo 'APP_KEY mise à jour dans .env' . "\n";
        }
        break;

    case 'migrate':
        foreach (glob(BASE_PATH . '/sql/*.sql') as $file) {
            if (str_ends_with($file, '_schema.sql')) {
                runSqlFile($file);
            }
        }
        break;

    case 'seed':
        foreach (glob(BASE_PATH . '/sql/*.sql') as $file) {
            if (! str_ends_with($file, '_schema.sql')) {
                runSqlFile($file);
            }
        }
        break;

    case 'migrate:all':
        foreach (glob(BASE_PATH . '/sql/*.sql') as $file) {
            runSqlFile($file);
        }
        break;

    case 'sla:run':
        $rappels = SlaHelper::runDue();
        $retards = SlaHelper::checkAlbumDelai();
        $clotures = EvenementService::autoCloturer();
        $rappelDemain = EvenementService::envoyerRappels();
        echo "SLA exécuté : {$rappels} rappel(s) envoyé(s), {$retards} alerte(s) retard créée(s), {$clotures} événement(s) clôturé(s) automatiquement, {$rappelDemain} rappel(s) événement(s) demain envoyé(s).\n";
        break;

    case 'gallery:thumbs':
        $photos = \App\Helpers\Database::all('SELECT id, image, thumbnail FROM photos WHERE image IS NOT NULL AND image <> ?', ['']);
        $done = 0;
        $skipped = 0;
        foreach ($photos as $photo) {
            if (! empty($photo['thumbnail'])) {
                $skipped++;
                continue;
            }
            $thumb = \App\Helpers\UploadHelper::makeThumbnail((string) $photo['image'], 400);
            if ($thumb !== null) {
                \App\Helpers\Database::run('UPDATE photos SET thumbnail = ? WHERE id = ?', [$thumb, (int) $photo['id']]);
                $done++;
            } else {
                $skipped++;
            }
        }
        echo "Vignettes générées : {$done} (déjà présentes ou échec : {$skipped})\n";
        break;

    case 'backup':
        runBackup();
        break;

    case 'queue:work':
        $count = processQueueJobs();
        SlaHelper::runDue();
        SlaHelper::checkAlbumDelai();
        $clotures = EvenementService::autoCloturer();
        $rappelDemain = EvenementService::envoyerRappels();
        echo "Queue traitée : {$count} job(s), {$clotures} événement(s) clôturé(s), {$rappelDemain} rappel(s) demain.\n";
        break;

    case 'queue:watch':
        echo "Watch de la queue démarré (Ctrl+C pour arrêter).\n";
        $tick = 0;
        while (true) {
            $count = processQueueJobs();
            if ($count > 0) {
                echo '[' . date('Y-m-d H:i:s') . "] {$count} job(s) traité(s).\n";
            }

            if ($tick % 30 === 0) {
                SlaHelper::runDue();
                SlaHelper::checkAlbumDelai();
                EvenementService::autoCloturer();
                EvenementService::envoyerRappels();
            }

            $tick++;
            sleep(1);
        }

    default:
        echo "Commande inconnue : {$command}\n";
        echo "Utilisez : php artisan help\n";
    }
